{
  "manifest_version": 3,
  "name": "Chat Continue Auto",
  "version": "1.0.48",
  "description": "Quando a IA para de gerar, insere um texto no input e envia — N vezes.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting", "activeTab", "notifications", "clipboardWrite", "clipboardRead"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://gemini.google.com/*",
    "https://notebooklm.google.com/*",
    "https://notebooklm.google/*",
    "https://*.notebooklm.google/*",
    "https://notebook.google.com/*",
    "https://*.notebook.google.com/*",
    "https://www.perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://aistudio.google.com/*"
  ],
  "action": {
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Chat Continue Auto — mostrar/ocultar ícone no site"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://gemini.google.com/*",
        "https://notebooklm.google.com/*",
        "https://notebooklm.google/*",
        "https://*.notebooklm.google/*",
        "https://notebook.google.com/*",
        "https://*.notebook.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://aistudio.google.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebooklm.google/*",
        "https://*.notebooklm.google/*",
        "https://notebook.google.com/*",
        "https://*.notebook.google.com/*"
      ],
      "js": ["notebooklm-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css", "picker.html", "picker.js", "notebooklm-bridge.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
